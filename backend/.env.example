# ==============================================================================
# PostRecaller Backend Configuration
# Copy this file to .env and fill in your values
# ==============================================================================

# --- Database (MongoDB Atlas M0 Free Tier or local MongoDB) ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=postrecaller

# --- Authentication ---
JWT_SECRET=generate-a-secure-random-secret-key-here
ACCESS_TOKEN_EXPIRE_DAYS=30
ADMIN_EMAILS=contactavysolutions@gmail.com

# --- AI Enrichment (Google Gemini API) ---
# Get your free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Transactional Email (Resend) ---
# Get key at https://resend.com/
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=PostRecaller <noreply@support.postrecaller.com>

# --- Optional Social Enrichers ---
# Reddit API (for fast Reddit thread enrichment via OAuth instead of scraping)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Jina Reader API (optional; lifts rate limit from 20 RPM to 500 RPM, free 10M tokens)
# Get free key at https://jina.ai/reader/
JINA_API_KEY=
